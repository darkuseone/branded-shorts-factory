{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darkuseone/branded-shorts-factory/schema/short.schema.json",
  "title": "Branded Shorts scenario",
  "description": "The one file the pipeline consumes. Editors get autocomplete from this; the authoritative validation lives in src/shorts_factory/spec.py, which also checks timings across fields.",
  "type": "object",
  "required": ["id", "title", "duration_target", "script", "visuals"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{1,63}$",
      "description": "Slug used for output filenames and the report."
    },
    "title": { "type": "string", "minLength": 1 },
    "topic": { "type": "string" },
    "rubric": {
      "type": "string",
      "description": "Channel rubric: космос / IT / технологии / AI / наука (and EN aliases). Drives music pick and meme bans."
    },
    "language": { "type": "string", "default": "ru" },
    "duration_target": { "type": "number", "minimum": 5, "maximum": 180 },

    "hook": {
      "description": "The opening beat. A bare string is accepted and auto-timed.",
      "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/segment" }]
    },
    "script": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/$defs/segment" }, "minItems": 1 },
        { "type": "string" }
      ]
    },

    "voice_settings": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "default": "elevenlabs" },
        "model": { "type": "string", "default": "eleven_v3" },
        "voice_id": { "type": "string" },
        "stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 47,
          "description": "0-100. Stay in 40-55 for short-form delivery."
        },
        "similarity_boost": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 },
        "style": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.35 },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2, "default": 1 },
        "language": { "type": "string" }
      }
    },

    "avatar": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "provider": {
          "type": "string",
          "default": "heygen",
          "description": "heygen (API) or external (jobs/<id>/avatar.mp4 committed after the chat-side HeyGen step)."
        },
        "avatar_id": { "type": "string", "description": "HeyGen look_id. Falls back to brandbook.avatar.look_id." },
        "external_path": {
          "type": "string",
          "description": "Optional path to a pre-rendered avatar clip. Default: jobs/<id>/avatar.mp4|.webm."
        },
        "version": { "type": "string", "default": "avatar_5" },
        "position": {
          "enum": ["bottom_right", "bottom_left", "bottom_center", "center", "fullscreen", "top_right"]
        },
        "scale": { "type": "number", "minimum": 0.1, "maximum": 1, "default": 0.34 },
        "background": { "type": "string", "default": "transparent" },
        "segments": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Script segment ids the avatar appears on. Empty = whole video."
        }
      }
    },

    "ring": {
      "type": "object",
      "description": "Pulse Ring overrides. Geometry defaults live in brand/brandbook.json.",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "anchor": { "enum": ["bottom_right", "bottom_left", "bottom_center", "center"] },
        "diameter_ratio": { "type": "number", "minimum": 0.1, "maximum": 0.8 }
      }
    },

    "sfx": {
      "type": "object",
      "description": "Sound-design policy for automatic placement.",
      "properties": {
        "policy": {
          "type": "object",
          "properties": {
            "max_effects": { "type": "integer", "minimum": 0, "maximum": 40 },
            "min_gap": { "type": "number", "minimum": 0.2, "maximum": 10, "default": 1.2 },
            "type_cooldown": { "type": "number", "minimum": 0, "maximum": 30, "default": 4 },
            "voice_guard": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.4 }
          }
        }
      }
    },

    "visuals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/visual" }
    },

    "music": {
      "type": "object",
      "properties": {
        "track": { "type": "string", "description": "Filename stem inside assets/music/." },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.18 },
        "ducking": { "type": "boolean", "default": true },
        "duck_to": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.06 },
        "fade_in": { "type": "number", "minimum": 0, "default": 0.5 },
        "fade_out": { "type": "number", "minimum": 0, "default": 1 },
        "start_at": { "type": "number", "minimum": 0, "default": 0 }
      }
    },

    "audio_fx": {
      "type": "array",
      "description": "ElevenLabs sound design. Leave empty to have it proposed automatically.",
      "items": {
        "type": "object",
        "required": ["at"],
        "properties": {
          "type": {
            "enum": [
              "whoosh", "impact", "riser", "swoosh", "click", "pop", "glitch",
              "sub_drop", "transition", "ui", "thump", "power_down", "power_up"
            ]
          },
          "at": { "type": "number", "minimum": 0 },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.6 },
          "duration": { "type": "number", "minimum": 0.05, "maximum": 5, "default": 0.8 },
          "prompt": { "type": "string" }
        }
      }
    },

    "captions": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "style": { "enum": ["karaoke", "word_pop", "line", "none"], "default": "karaoke" },
        "font": { "type": "string", "default": "Inter" },
        "size": { "type": "integer", "minimum": 24, "maximum": 160, "default": 72 },
        "position": {
          "enum": ["center", "center_bottom", "bottom", "top", "upper_third", "lower_third"]
        },
        "max_chars_per_line": { "type": "integer", "minimum": 10, "maximum": 48, "default": 22 },
        "highlight_color": { "type": "string", "default": "#FF2A3C" },
        "text_color": { "type": "string", "default": "#FFFFFF" },
        "stroke": { "type": "boolean", "default": true },
        "uppercase": { "type": "boolean", "default": false }
      }
    },

    "brand_elements": {
      "type": "object",
      "description": "Per-video overrides. Anything left out falls back to brand/brandbook.json.",
      "properties": {
        "logo": { "type": "string" },
        "logo_position": { "enum": ["top_left", "top_right", "bottom_left", "bottom_right", "none"] },
        "lower_third": { "type": "boolean", "default": false },
        "color_primary": { "type": "string" },
        "color_accent": { "type": "string" },
        "color_background": { "type": "string" },
        "font_family": { "type": "string" },
        "intro_sting": { "type": "boolean", "default": false },
        "outro_card": { "type": "boolean", "default": true },
        "safe_area": { "type": "boolean", "default": true },
        "watermark_opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.85 }
      }
    },

    "cta": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "start": { "type": "number", "minimum": 0 },
            "duration": { "type": "number", "minimum": 0.5, "default": 3 },
            "style": { "enum": ["badge", "banner", "card", "text", "arrow"], "default": "badge" },
            "url": { "type": "string" }
          }
        }
      ]
    },

    "memes": {
      "type": "object",
      "description": "Memes are only ever inserted on an explicit tag match against assets/memes/.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "tags": { "type": "array", "items": { "type": "string" } },
        "max_count": { "type": "integer", "minimum": 0, "maximum": 5, "default": 1 },
        "max_duration": { "type": "number", "minimum": 0.2, "maximum": 4, "default": 1.5 }
      }
    },

    "constraints": {
      "type": "object",
      "properties": {
        "magnific_token_budget": { "type": "integer", "minimum": 0 },
        "allow_generative": { "type": "boolean", "default": true },
        "require_vision_qa": { "type": "boolean", "default": true },
        "min_visual_score": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.62 },
        "manual_review_ok": { "type": "boolean", "default": true }
      }
    }
  },

  "$defs": {
    "segment": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "minimum": 0.05 },
        "emphasis": { "enum": ["low", "normal", "high"], "default": "normal" },
        "on_camera": { "type": "boolean", "default": false },
        "pause_after": { "type": "number", "minimum": 0, "default": 0 }
      }
    },
    "visual": {
      "type": "object",
      "required": ["start", "duration"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": ["footage", "image", "motion_graphics", "infographic", "meme", "screen_record", "generated"],
          "default": "footage"
        },
        "query": {
          "type": "string",
          "description": "Primary search phrase. English works best — stock APIs are English-first."
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "description": "2-4 synonyms searched in parallel with the primary query."
        },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "minimum": 0.2 },
        "position": {
          "enum": ["fullscreen", "top", "bottom", "center", "pip", "left", "right", "background"],
          "default": "fullscreen"
        },
        "motion": {
          "enum": ["none", "kenburns", "parallax", "zoom_in", "zoom_out", "pan_left", "pan_right"],
          "default": "none"
        },
        "priority": { "enum": ["low", "normal", "high", "critical"], "default": "normal" },
        "segment_ref": { "type": "string", "description": "Script segment this shot illustrates." },
        "allow_magnific": { "type": "boolean", "default": true },
        "allow_generative": { "type": "boolean", "default": true },
        "quality_floor": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "must_include": { "type": "array", "items": { "type": "string" } },
        "must_avoid": { "type": "array", "items": { "type": "string" } },
        "source_hint": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
