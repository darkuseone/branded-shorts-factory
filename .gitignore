# Build output — everything here is reproducible from a scenario JSON.
build/
*.mp4
*.webm
*.mov

# Two-phase avatar clips must be committed so Actions can render without HeyGen.
!jobs/**/avatar.mp4
!jobs/**/avatar.webm
# Optional closer crop (ffmpeg) when the HeyGen framing sits the talent too far.
!jobs/**/avatar_close.mp4

# Pre-staged Magnific/stock b-roll for keyless cloud renders.
!jobs/**/broll/*.mp4
!jobs/**/broll/*.webm
!jobs/**/broll/*.jpg
!jobs/**/broll/*.png

# Optional avatar-extracted VO fallback when ElevenLabs is unavailable.
!jobs/**/voice_from_avatar.mp3

# The asset banks must be committed, not ignored. GitHub Actions builds from a
# fresh clone, so anything the render needs — memes, music, sounds, logo,
# brandbook, meme cadence — has to be in the tree or the build silently comes
# out without it. The blanket *.mp4 rule above would swallow them, so undo it
# here explicitly.
!assets/**/*.mp4
!assets/**/*.webm
!assets/**/*.mov

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/

# Node / HyperFrames
node_modules/
.skills/

# Editors and OS
.DS_Store
.idea/
.vscode/

# Per-slot stock before bake (master/broll.mp4 is the committed track)
jobs/**/broll/v[0-9].mp4
jobs/**/broll/v[0-9]_clip.mp4
