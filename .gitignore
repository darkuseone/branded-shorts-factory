# Build output — everything here is reproducible from a scenario JSON.
build/
*.mp4
*.webm
*.mov

# Two-phase avatar clips must be committed so Actions can render without HeyGen.
!jobs/**/avatar.mp4
!jobs/**/avatar.webm

# NOTE: assets/music, assets/sfx, assets/memes, brand/ and .state/ are
# deliberately NOT ignored. GitHub Actions builds from a fresh clone, so
# anything the render needs — tracks, sounds, memes, logo, brandbook, meme
# cadence — has to be committed or the build silently comes out without it.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/

# Node / HyperFrames
node_modules/
.skills/

# Editors and OS
.DS_Store
.idea/
.vscode/
